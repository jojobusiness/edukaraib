rules_version = '2';

// EduKaraib — Regles Firestore Phase 1 (2026-06-12)
// Avant : allow read, write: if true sur TOUTE la base (critique).
// Principes :
//  - deny by default (match final)
//  - lecture publique uniquement pour ce que les pages publiques consomment
//    (profils, avis, creneaux) — Search/Home/TeacherProfile/SEO sans login
//  - collections ARGENT : ecriture client INTERDITE — seules les API Vercel
//    (Admin SDK, qui ignore les regles) ecrivent
//  - pas d'auto-promotion : un user ne peut pas changer son propre role
//  - le client ne peut jamais poser is_paid/paid_at sur une lecon
// Phase 2 : payments/subscriptions restreints le 19/10/2026.
// Phase 3 (23/10/2026) : users, students, documents, favorites, presence,
// parents, children fermes. Phase 4 (23/10/2026) : lessons fermes (acces +
// copie publique creneaux + /api/rejoindre-groupe), « paye » forge bloque.
// Phase 5 (23/10/2026) : champs serveur de users, avis, notifications,
// promo_codes, prix/gratuite/horaire des cours. Storage : storage.rules.
// Preuve : npm run test:regles (emulateur) + scripts/diag-regles-donnees.mjs (prod).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Profils ────────────────────────────────────────────────────────────
    // 🔒 23/10/2026 — AVANT : `allow read: if true`. SANS AUCUN COMPTE, on
    // listait les 36 comptes : e-mail, telephone, date de naissance, compte
    // Stripe. Desormais `users` ne se lit que par soi-meme et l'admin. Ce que
    // les autres ont le droit de voir est recopie dans `profils` (ci-dessous).
    // Ecriture : soi-meme sans toucher au role (anti-escalade), admin libre.
    // partner_uid : partenaire auquel la famille est rattachée (remise + reversement
    // sur tous ses achats). Posé par le webhook de paiement uniquement : une
    // famille ne peut ni se rattacher elle-même, ni changer de partenaire.
    // 🔒 23/10/2026 — Champs que SEUL le serveur (ou l'admin) écrit. Avant, un
    // compte pouvait lui-même : se débannir (disabled), effacer son
    // parrainage pour le rejouer (referredBy…), s'attribuer des filleuls ou
    // un code promo (promo), se déclarer « Stripe prêt », remettre à zéro ses
    // essais gratuits (trialUsedWith), ou prendre le code parrain d'un autre.
    // Un formulaire qui renvoie la fiche entière (Profile.jsx) reste accepté :
    // valeur inchangée, ou valeur vide pour un champ qui n'existait pas.
    function intactOuVide(k) {
      return request.resource.data.get(k, null) == resource.data.get(k, null)
        || (!(k in resource.data) && request.resource.data.get(k, null) in [null, '', false, 0]);
    }
    function videALaCreation(k) {
      return request.resource.data.get(k, null) in [null, '', false, 0];
    }
    function champsServeurIntacts() {
      return intactOuVide('disabled') && intactOuVide('stripeAccountId')
        && intactOuVide('stripeChargesEnabled') && intactOuVide('stripePayoutsEnabled')
        && intactOuVide('stripeDetailsSubmitted')
        && intactOuVide('referredBy') && intactOuVide('referredByCode') && intactOuVide('referredAt')
        && intactOuVide('studentReferredBy') && intactOuVide('studentReferredByCode')
        && intactOuVide('studentReferredAt')
        && intactOuVide('referralFilleuls') && intactOuVide('studentReferralFilleuls')
        && intactOuVide('promo') && intactOuVide('partner_uid') && intactOuVide('partner_linked_at')
        // codes parrain : posés une fois, jamais changés
        && (!('referralCode' in resource.data) || intactOuVide('referralCode'))
        && (!('studentReferralCode' in resource.data) || intactOuVide('studentReferralCode'))
        // essais gratuits : la liste ne fait que grandir
        && request.resource.data.get('trialUsedWith', []).hasAll(resource.data.get('trialUsedWith', []))
        // « e-mail vérifié » : seulement ce que dit Firebase Auth
        && (request.resource.data.get('email_verified', null) == resource.data.get('email_verified', null)
            || request.resource.data.get('email_verified', null) == request.auth.token.email_verified);
    }
    function creationSansPrivilege() {
      return videALaCreation('disabled') && videALaCreation('stripeAccountId')
        && videALaCreation('stripeChargesEnabled') && videALaCreation('stripePayoutsEnabled')
        && videALaCreation('stripeDetailsSubmitted')
        && videALaCreation('referredBy') && videALaCreation('studentReferredBy')
        && videALaCreation('referralFilleuls') && videALaCreation('studentReferralFilleuls')
        && videALaCreation('promo') && videALaCreation('trialUsedWith')
        && (request.resource.data.get('email_verified', false) == false
            || request.resource.data.get('email_verified', false) == request.auth.token.email_verified);
    }
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin()
        || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow create: if isSelf(uid)
        && request.resource.data.get('role', 'student') in ['student', 'parent', 'teacher']
        && !('partner_uid' in request.resource.data)
        && creationSansPrivilege();
      allow update: if isAdmin()
        || (isSelf(uid) && request.resource.data.get('role', '') == resource.data.get('role', '')
            && champsServeurIntacts());
      allow delete: if isAdmin() || isSelf(uid);
    }

    // Copie publique de chaque compte, ecrite UNIQUEMENT par la Cloud Function
    // onUserWrittenSyncProfil, sur une liste blanche (functions/profilPublic.js) :
    // vitrine complete d'un prof, nom et avatar seulement pour les autres.
    // Lecture d'une fiche : publique (les avis affichent le nom de leur auteur).
    // Liste : seulement les profs (recherche, accueil) et l'admin (support).
    match /profils/{uid} {
      allow get: if true;
      allow list: if isAdmin() || resource.data.role in ['teacher', 'admin'];
      allow write: if false;
    }

    // Ancienne vitrine, vide et plus lue : fermee en ecriture (23/10/2026)
    match /teachers/{id} {
      allow read: if true;
      allow write: if false;
    }

    // 🔒 23/10/2026 — AVANT : `read, write: if signedIn()`. Tout compte lisait,
    // modifiait et supprimait le nom et la DATE DE NAISSANCE des enfants.
    // Desormais : le parent, l'eleve lui-meme, l'admin. Le prof d'un cours
    // obtient le nom (sans date de naissance) par /api/fiches-eleves.
    function ficheAMoi() {
      return signedIn() && (
        resource.data.get('parent_id', '') == request.auth.uid
        || resource.data.get('user_id', '') == request.auth.uid
        || resource.data.get('uid', '') == request.auth.uid
      );
    }
    match /students/{id} {
      allow read: if isAdmin() || ficheAMoi();
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.get('parent_id', '') == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn() && resource.data.get('parent_id', '') == request.auth.uid
            && request.resource.data.get('parent_id', '') == request.auth.uid);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.get('parent_id', '') == request.auth.uid);
    }
    // Vides et plus utilisees (23/10/2026)
    match /parents/{document=**}  { allow read, write: if isAdmin(); }
    match /children/{id} { allow read, write: if isAdmin(); }

    // Avis publics (carousel Home, profils)
    // 🔒 23/10/2026 — AVANT : `create: if signedIn()`. N'importe quel compte
    // notait n'importe quel prof (faux avis, sabotage). Désormais : un avis
    // par compte et par cours (id = {lesson_id}_{uid}), sur un cours TERMINÉ
    // dont on fait partie, note entière de 1 à 5.
    function coursDeLAvis() {
      return get(/databases/$(database)/documents/lessons/$(request.resource.data.lesson_id)).data;
    }
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn()
        && id == request.resource.data.lesson_id + '_' + request.auth.uid
        && request.resource.data.get('left_by_parent_id', '') == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.get('comment', '').size() <= 2000
        && coursDeLAvis().get('status', '') == 'completed'
        && coursDeLAvis().get('teacher_id', '') == request.resource.data.get('teacher_id', '')
        && (request.auth.uid in coursDeLAvis().get('acces', [])
            || request.auth.uid in coursDeLAvis().get('participant_ids', [])
            || coursDeLAvis().get('student_id', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── Lecons ─────────────────────────────────────────────────────────────
    // 🔒 23/10/2026 — AVANT : `allow read: if true` (sans compte : eleve,
    // parent, creneau, prix, paiement de chaque cours) et `update: if signedIn()`
    // (n'importe qui modifiait le cours d'un autre). Desormais : les comptes
    // du cours. `acces` est tenu par la Cloud Function onLessonWrittenSync
    // (functions/coursAcces.js). La page publique d'un prof lit `creneaux`.
    // Une requete doit prouver qu'elle ne lit que ses cours : teacher_id ==
    // moi, student_id == moi, participant_ids / acces array-contains moi.
    // Plan : docs/plans/PLAN_VERROU_COURS_23-10-2026.md.
    function dansLeCours() {
      return signedIn() && (
        resource.data.get('teacher_id', '') == request.auth.uid
        || resource.data.get('student_id', '') == request.auth.uid
        || request.auth.uid in resource.data.get('participant_ids', [])
        || request.auth.uid in resource.data.get('acces', [])
      );
    }
    // 💸 Fraude fermee le 23/10/2026 : un participant passait
    // participantsMap.<eleve>.is_paid a true sur son propre cours ;
    // create-checkout-session le croyait « deja paye » et ne le faisait
    // jamais payer. Pour chaque participant, is_paid ne devient true que
    // s'il l'etait deja (seul le webhook, Admin SDK, le pose). Exception :
    // le prof qui passe en groupe un cours individuel DEJA paye (il recopie
    // lesson.is_paid sur l'eleve d'origine). Une regle ne sait pas boucler :
    // verification deroulee sur 20 participants, au-dela la mise a jour est refusee.
    function paiementNonForge(i) {
      let nouv = request.resource.data.get('participantsMap', {});
      let anc = resource.data.get('participantsMap', {});
      let cles = nouv.keys();
      return cles.size() <= i
        || ((nouv[cles[i]].get('is_paid', false) != true
              || anc.get(cles[i], {}).get('is_paid', false) == true
              || (resource.data.get('is_paid', false) == true
                  && cles[i] == resource.data.get('student_id', '')))
            // 23/10/2026 : « heure offerte » ne s'ajoute pas non plus après coup
            && (nouv[cles[i]].get('is_free_hour', false) != true
                || anc.get(cles[i], {}).get('is_free_hour', false) == true));
    }
    // Horaire figé, sauf pour réactiver une demande refusée (TeacherProfile).
    // Sinon un prof antidatait le cours pour se faire verser avant qu'il ait lieu.
    function horaireIntact() {
      return resource.data.get('status', '') in ['rejected', 'removed', 'deleted']
        || !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['slot_day', 'slot_hour', 'date', 'week', 'startAt', 'start_datetime']);
    }
    function aucunPaiementForge() {
      return request.resource.data.get('participantsMap', {}).keys().size() <= 20
        && paiementNonForge(0)
        && paiementNonForge(1)
        && paiementNonForge(2)
        && paiementNonForge(3)
        && paiementNonForge(4)
        && paiementNonForge(5)
        && paiementNonForge(6)
        && paiementNonForge(7)
        && paiementNonForge(8)
        && paiementNonForge(9)
        && paiementNonForge(10)
        && paiementNonForge(11)
        && paiementNonForge(12)
        && paiementNonForge(13)
        && paiementNonForge(14)
        && paiementNonForge(15)
        && paiementNonForge(16)
        && paiementNonForge(17)
        && paiementNonForge(18)
        && paiementNonForge(19);
    }
    match /lessons/{id} {
      allow read: if isAdmin() || dansLeCours();
      // Creation en son nom ; un participant « deja paye » seulement pour
      // un essai gratuit (is_trial, prix 0)
      // Gratuit : seulement un essai que le prof propose, ou les heures
      // offertes d'un pack (leur nombre est vérifié par la Cloud Function).
      allow create: if signedIn()
        && request.resource.data.get('is_paid', false) == false
        && request.auth.uid in request.resource.data.get('acces', [])
        && !('gratuite_refusee' in request.resource.data)
        && (request.resource.data.get('is_free_hour', false) != true
            || request.resource.data.get('pack', false) == true
            || request.resource.data.get('is_trial', false) == true)
        && ((request.resource.data.get('is_trial', false) == true
               && request.resource.data.get('price_per_hour', 0) == 0
               && get(/databases/$(database)/documents/users/$(request.resource.data.teacher_id))
                    .data.get('trial_enabled', false) == true)
            || creationSansPaiement());
      allow update: if isAdmin()
        || (dansLeCours()
            && request.resource.data.get('teacher_id', '') == resource.data.get('teacher_id', '')
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['is_paid', 'paid_at', 'paid_by', 'total_amount',
                          'payment_intent_id', 'stripe_charge_id',
                          // 23/10/2026 : prix, gratuité, durée — décidés à la création
                          'price_per_hour', 'is_free_hour', 'free_reason', 'is_trial',
                          'duration_hours', 'gratuite_refusee', 'gratuite_refusee_raison'])
            && horaireIntact()
            && aucunPaiementForge());
      // Aucun ecran ne supprime de cours : prof du cours et admin.
      allow delete: if isAdmin()
        || (signedIn() && resource.data.get('teacher_id', '') == request.auth.uid);
    }
    function creationSansPaiement() {
      let pm = request.resource.data.get('participantsMap', {});
      let cles = pm.keys();
      return request.resource.data.get('is_trial', false) != true
        && cles.size() <= 1
        && (cles.size() == 0 || (pm[cles[0]].get('is_paid', false) != true
            && (pm[cles[0]].get('is_free_hour', false) != true
                || request.resource.data.get('pack', false) == true)));
    }

    // Copie publique des cours, SANS aucun identifiant d'eleve : jour, heure,
    // statut, groupe, capacite, places prises. Ecrite uniquement par la Cloud
    // Function onLessonWrittenSync. Lue par la page publique d'un prof.
    match /creneaux/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ── Notifications ──────────────────────────────────────────────────────
    // 🔒 23/10/2026 — AVANT : `create: if signedIn()`, et la Cloud Function
    // envoyait par e-mail le titre et le texte LIBRES de la notification : tout
    // compte écrivait un mail « EduKaraib » à n'importe quel inscrit. Désormais
    // les types sont fixés, le texte est borné, et pour les types créés depuis
    // le navigateur la fonction envoie un texte FIXE (functions/index.js,
    // MODELES_EMAIL). Le message d'annonce (admin_broadcast) : admin seulement.
    match /notifications/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.user_id == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.get('user_id', '') is string
        && request.resource.data.get('message', '').size() <= 1000
        && request.resource.data.get('title', '').size() <= 200
        && !('email_sent' in request.resource.data)
        && (request.resource.data.get('type', '') in ['lesson_request', 'review_left', 'document_shared',
              'group_invite', 'group_invite_accepted', 'payment_due',
              'cours_accepted', 'cours_rejected', 'cours_completed']
            || (request.resource.data.get('type', '') == 'admin_broadcast' && isAdmin()));
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.user_id == request.auth.uid);
    }

    // ── Messagerie ─────────────────────────────────────────────────────────
    // ⚖️ Secret des correspondances (15/10/2026) : la DEMANDE de mise en
    // relation est un événement du service, distinct du contenu échangé. Écrite
    // uniquement par le serveur (Admin SDK, qui ignore ces règles) ; l'admin la
    // lit pour relancer un prof qui ne répond pas. Personne d'autre.
    match /demandes_contact/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Signalement : c'est l'UTILISATEUR qui transmet lui-même un message à
    // l'équipe (DSA art. 16). C'est la seule voie par laquelle un contenu de
    // conversation arrive légalement sous les yeux de l'équipe.
    match /signalements/{id} {
      allow create: if signedIn() && request.resource.data.auteur_uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ⚖️ 15/10/2026 — AVANT, c'était `allow read, write: if signedIn()` :
    // n'importe quel compte connecté pouvait lire TOUTES les conversations du
    // site. Secret des correspondances (CPCE art. L32-3) : seuls les deux
    // correspondants accèdent à leur échange. L'admin n'y échappe pas — il ne
    // voit que les conversations auxquelles il participe.
    // ⚠️ Une requête doit prouver qu'elle ne lit que des documents autorisés :
    // tout `get`/`list` sur ces collections doit porter un
    // `array-contains` sur participants / participants_uids.
    match /conversations/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      // Accusés de lecture et dernier message : la liste des participants ne bouge jamais
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      // ⛔ 15/10/2026 : plus de suppression depuis le site. Un participant
      // masque la conversation pour lui (champ hiddenFor) ; elle reste en base
      // 12 mois pour un éventuel litige (harcèlement, arnaque), puis le serveur
      // la purge. Avant, le premier qui cliquait « Supprimer » effaçait aussi
      // la copie de l'autre : le harceleur pouvait détruire la preuve.
      allow delete: if false;
    }
    match /messages/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants_uids;
      // On n'écrit qu'en son propre nom, et seulement dans une conversation dont on fait partie
      allow create: if signedIn()
        && request.resource.data.sender_uid == request.auth.uid
        && request.auth.uid in request.resource.data.participants_uids;
      // ⛔ Un message ne se réécrit pas : l'historique d'un échange doit rester intact
      allow update: if false;
      // ⛔ Ni effacé : la purge des 12 mois est faite par le serveur
      allow delete: if false;
    }
    // 23/10/2026 : chacun n'ecrit que SA presence
    match /presence/{id} {
      allow read: if signedIn();
      allow write: if isSelf(id);
    }

    // 🔒 23/10/2026 — Documents de cours. AVANT : `read, write: if signedIn()`,
    // tout compte lisait et supprimait les fichiers de tout le monde.
    // `acces` = comptes du cours (prof, eleves, parents), pose a l'envoi :
    // frontend/lib/accesCours.js. Toute lecture doit filtrer
    // `where('acces', 'array-contains', moi)`.
    function profDuCoursDuDocument() {
      return signedIn() && get(/databases/$(database)/documents/lessons/$(resource.data.lesson_id))
        .data.get('teacher_id', '') == request.auth.uid;
    }
    match /documents/{id} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid in resource.data.get('acces', []));
      allow create: if signedIn()
        && request.resource.data.get('sender_id', '') == request.auth.uid
        && request.auth.uid in request.resource.data.get('acces', []);
      allow update: if isAdmin()
        || ((resource.data.get('sender_id', '') == request.auth.uid || profDuCoursDuDocument())
            && request.resource.data.get('sender_id', '') == resource.data.get('sender_id', ''))
        // Le prof complete l'acces quand un eleve rejoint le cours apres coup
        || (signedIn() && request.auth.uid in resource.data.get('acces', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acces']));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.get('sender_id', '') == request.auth.uid)
        || profDuCoursDuDocument();
    }

    // 23/10/2026 : favoris = ceux du compte connecte, personne d'autre
    match /favorites/{id} {
      allow read, delete: if signedIn() && resource.data.get('user_id', '') == request.auth.uid;
      allow create: if signedIn() && request.resource.data.get('user_id', '') == request.auth.uid;
      allow update: if signedIn() && resource.data.get('user_id', '') == request.auth.uid
        && request.resource.data.get('user_id', '') == request.auth.uid;
    }

    // Codes promo bonus pack (lecture connectee, gestion admin)
    // 23/10/2026 : était `read: if signedIn()` — chacun ne lit que SON code
    // (la page du prof le vérifie par son identifiant). Écrits par la Cloud
    // Function (premier avis) ; marqués « used » par onLessonWrittenSync.
    match /promo_codes/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.get('owner_id', '') == request.auth.uid);
      allow write: if isAdmin();
    }

    // ── ARGENT : ecriture client interdite partout ─────────────────────────
    // 🔒 19/10/2026 — AVANT : `allow read: if signedIn()` sur payments et
    // subscriptions. N'IMPORTE QUEL compte connecte pouvait lire TOUS les
    // paiements du site : montants, qui a paye quel prof, pour quel enfant.
    // Desormais : l'admin, et les seules personnes concernees par le paiement.
    // Rappel : une requete doit PROUVER qu'elle ne lit que ses documents
    // (where payer_uid/teacher_uid/for_student == son uid), sinon refus total.
    // Verifie depuis l'exterieur par scripts/diag-regles-paiements.mjs.
    function concerneParPaiement() {
      return signedIn() && (
        resource.data.get('payer_uid', '') == request.auth.uid
        || resource.data.get('teacher_uid', '') == request.auth.uid
        || resource.data.get('teacher_id', '') == request.auth.uid
        || resource.data.get('for_student', '') == request.auth.uid
      );
    }
    match /payments/{id} {
      allow read: if isAdmin() || concerneParPaiement();
      allow write: if false;
    }
    match /subscriptions/{id} {
      allow read: if isAdmin() || (signedIn() && (
        resource.data.get('payer_uid', '') == request.auth.uid
        || resource.data.get('student_id', '') == request.auth.uid
        || resource.data.get('teacher_id', '') == request.auth.uid
      ));
      allow write: if false;
    }
    match /coupons/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.user_uid == request.auth.uid);
      allow write: if false;
    }
    match /influencers/{id} {
      // IBAN dedans : lecture limitee au proprietaire + admin
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }
    match /influencer_usages/{id} { allow read, write: if false; }
    match /refund_requests/{id} {
      allow read, update: if isAdmin(); // refus traite cote client admin
      allow create, delete: if false;   // creation via /api/refund-request
    }
    match /refunds/{id} { allow read, write: if isAdmin(); }
    match /payouts/{id} {
      allow read: if isAdmin(); // 19/10/2026 : etait signedIn(), aucun lecteur client
      allow write: if false;
    }

    // Analytics (onglet admin) — ecrits par l'API drain (Admin SDK)
    match /analytics_top/{id}   { allow read: if isAdmin(); allow write: if false; }
    match /analytics_daily/{id} { allow read: if isAdmin(); allow write: if false; }

    // ── Tout le reste : interdit ───────────────────────────────────────────
    match /{document=**} { allow read, write: if false; }
  }
}
