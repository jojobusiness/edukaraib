{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Frame-Options": "SAMEORIGIN",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(self \"https://8x8.vc\"), microphone=(self \"https://8x8.vc\"), geolocation=()",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
      },
      "continue": true
    },
    { "src": "/sitemap.xml", "dest": "/api/sitemap.mjs" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/((?!api|.*\\..*).*)", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/lesson-reminders", "schedule": "*/30 * * * *" },
    { "path": "/api/subscription-renewal-cron", "schedule": "0 6 * * *" }
  ]
}